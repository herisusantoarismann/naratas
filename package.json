{
	"name": "block-docs-engine",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:arch": "vitest run tests/01-architecture.test.ts",
		"test:utils": "vitest run tests/02-unit-utils-serializer.test.ts",
		"test:engine": "vitest run tests/03-unit-document-engine.test.ts",
		"test:actions": "vitest run tests/04-unit-actions.test.ts",
		"test:components": "vitest run tests/05-components-blocks.test.ts",
		"test:perf": "vitest run tests/06-performance-ssr.test.ts",
		"test:e2e": "playwright install && playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:all": "vitest run && playwright test",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "latest",
		"@eslint/js": "^10.0.1",
		"@playwright/mcp": "^0.0.20",
		"@playwright/test": "^1.60.0",
		"@storybook/addon-a11y": "^10.6.5",
		"@storybook/addon-docs": "^10.6.5",
		"@storybook/addon-svelte-csf": "latest",
		"@storybook/addon-vitest": "^10.6.5",
		"@storybook/sveltekit": "^10.6.5",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/jest-dom": "^6.4.2",
		"@testing-library/svelte": "^5.2.0",
		"@testing-library/user-event": "^14.5.2",
		"@types/node": "^22.20.5",
		"@vitest/browser-playwright": "^4.1.8",
		"@vitest/coverage-v8": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.6.5",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"jsdom": "^24.0.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"storybook": "^10.6.5",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.118.0"
	}
}
